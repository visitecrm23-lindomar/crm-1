# Database
DATABASE_URL=postgresql://user:password@localhost:5432/visitecrm

# Email (Resend)
RESEND_API_KEY=re_...

# Redis (BullMQ async job queue)
# Required for async email queuing, retry, and scheduled reminders.
# When absent, emails are sent synchronously (no queue, no retries).
# Recommended: Upstash Redis (see task #289 for provisioning guide).
# Format: redis://default:<password>@<host>:<port>
REDIS_URL=redis://default:password@localhost:6379

# Auth (Clerk)
CLERK_SECRET_KEY=sk_...
VITE_CLERK_PUBLISHABLE_KEY=pk_...

# UploadThing
UPLOADTHING_TOKEN=...

# Google Calendar (optional)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
