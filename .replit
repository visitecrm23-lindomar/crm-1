modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter visitecrm run dev"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
FRONTEND_URL = "https://visitecrm.com"
ADDITIONAL_ORIGINS = "https://visite-crm.replit.app"
CLERK_PROXY_URL = "https://visitecrm.com/api/__clerk"
VITE_APP_URL = "https://visitecrm.com"
VITE_CLERK_PROXY_URL = "https://visitecrm.com/api/__clerk"

[userenv.shared]
VITE_UPLOADTHING_URL = "/api/uploadthing"

[userenv.development]
CLERK_PROXY_URL = "https://visite-crm.replit.app/api/__clerk"
